<Window x:Class="DevFolders.Views.IconPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="800" Height="620" MinWidth="640" MinHeight="500"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="200" />
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Column="0">
            <TextBlock x:Name="FoundHeader" DockPanel.Dock="Top" Style="{StaticResource SectionHeader}" TextWrapping="Wrap" />

            <ListBox x:Name="FoundList" DockPanel.Dock="Top" MaxHeight="250" Margin="0,0,0,16"
                     ItemsPanel="{StaticResource WrapItems}" Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     SelectionChanged="OnFoundSelected">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Width="110" Margin="2,4">
                            <Image Source="{Binding Preview}" Width="64" Height="64" />
                            <TextBlock Text="{Binding Label}" ToolTip="{Binding Label}" FontSize="12" Margin="0,6,0,0"
                                       TextAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock DockPanel.Dock="Top" Text="Icon library" Style="{StaticResource SectionHeader}" />

            <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="SearchBox" PreviewKeyDown="OnSearchKeyDown" VerticalContentAlignment="Center" />
                <Button Grid.Column="1" Content="Search" Margin="8,0,0,0" Click="OnSearch" />
                <Button Grid.Column="2" Content="Browse file..." Margin="8,0,0,0" Click="OnBrowse" />
            </Grid>

            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,12,0,0">
                <TextBlock Text="Badge color" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ListBox x:Name="ColorList" Background="Transparent" BorderThickness="0" SelectionChanged="OnColorSelected">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Ellipse Width="20" Height="20" Fill="{Binding}" StrokeThickness="1"
                                     Stroke="{DynamicResource ControlStrokeColorDefaultBrush}" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>

            <TextBlock x:Name="LibraryStatus" DockPanel.Dock="Bottom" Style="{StaticResource SecondaryText}" />

            <ListBox x:Name="LibraryList" ItemsPanel="{StaticResource WrapItems}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     SelectionChanged="OnLibrarySelected">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Rectangle Width="24" Height="24" Margin="4" ToolTip="{Binding Id}"
                                   Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}">
                            <Rectangle.OpacityMask>
                                <ImageBrush ImageSource="{Binding Glyph}" Stretch="Uniform" />
                            </Rectangle.OpacityMask>
                        </Rectangle>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <Border Grid.Column="1" Margin="24,0,0,0" Padding="16" CornerRadius="8"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
            <StackPanel>
                <TextBlock Text="Preview" Style="{StaticResource SectionHeader}" />
                <Image x:Name="LargePreview" Width="128" Height="128" Margin="0,8,0,16" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Image x:Name="SmallPreview" Width="16" Height="16" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                    <TextBlock x:Name="SmallPreviewName" Margin="6,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Cancel" MinWidth="96" IsCancel="True" />
            <Button x:Name="ApplyButton" Content="Apply" MinWidth="96" Margin="8,0,0,0" IsEnabled="False"
                    Style="{DynamicResource AccentButtonStyle}" Click="OnApply" />
        </StackPanel>
    </Grid>
</Window>

<Window x:Class="DevFolders.Views.DevFolderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dev folder" Width="580" Height="560" MinWidth="460" MinHeight="380"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal">
            <Image x:Name="FolderPreview" Width="64" Height="64" />
            <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="HeaderText" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Text="Apply icons to these projects?" Style="{StaticResource SecondaryText}" Margin="0,2,0,0" />
            </StackPanel>
        </StackPanel>

        <Border Grid.Row="1" Margin="0,20,0,0" CornerRadius="8" Padding="8,4"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="ProjectList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="4,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <CheckBox IsChecked="{Binding IsChecked}" IsEnabled="{Binding HasIcon}" VerticalAlignment="Center"
                                          MinWidth="0" Margin="0,0,8,0" />
                                <Image Grid.Column="1" Source="{Binding Preview}" Width="32" Height="32" Margin="0,0,12,0" />
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Detail}" FontSize="12" TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Skip" MinWidth="96" IsCancel="True" />
            <Button x:Name="ApplyButton" MinWidth="96" Margin="8,0,0,0"
                    Style="{DynamicResource AccentButtonStyle}" Click="OnApply" />
        </StackPanel>
    </Grid>
</Window>
